# ============================================
# CROLANA FULL ENVIRONMENT CONFIGURATION
# ============================================

# IMPORTANT: Copy this file to .env
# Fill in real values and NEVER commit .env to Git!

# ============================================
# CORE SERVER
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/crolana?schema=public"

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=super-long-random-secret-key-here-change-in-prod
JWT_EXPIRES_IN=7d

# ============================================
# BLOCKCHAIN RPC ENDPOINTS
# ============================================
# Cronos Mainnet
CRONOS_RPC_URL=https://evm.cronos.org
CRONOS_CHAIN_ID=25

# Cronos Testnet
CRONOS_TESTNET_RPC_URL=https://evm-t3.cronos.org

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Better: Use Helius or QuickNode
SOLANA_HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ============================================
# STORAGE & IPFS
# ============================================
PINATA_API_KEY=pk_...
PINATA_SECRET_API_KEY=sk_...
LIGHTHOUSE_API_KEY=lighthouse_...
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ============================================
# WALLET CONNECT
# ============================================
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_from_walletconnect_cloud
VITE_ENABLE_WALLETCONNECT=true

# ============================================
# EXTERNAL APIs
# ============================================
HELIUS_API_KEY=your_helius_api_key
COVALENT_API_KEY=your_covalent_key
SENTRY_DSN=https://your-sentry-dsn

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# MOBILE / CAPACITOR
# ============================================
CAPACITOR_URL=https://your-deployed-backend.com

# ============================================
# OPTIONAL SERVICES
# ============================================
METADATA_SERVICE_URL=http://localhost:3001

# AI Features (optional)
# OPENAI_API_KEY=sk-...

# ============================================
# DEPLOYMENT KEYS (USE SECRET MANAGER IN PROD!)
# ============================================
# DEPLOYER_PRIVATE_KEY=0x...
# SOLANA_KEYPAIR=your_base58_keypair
